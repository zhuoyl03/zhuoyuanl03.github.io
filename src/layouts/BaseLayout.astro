---
import "../styles/global.css";
import { Sun, Moon, X } from "@lucide/astro";
const { title = "Zhuoyuan Li", description = "Zhuoyuan Li, computer science undergraduate at Purdue University." } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#090a0c" />
    <script is:inline>
      try {
        if (localStorage.getItem("portfolio-theme") === "light") {
          document.documentElement.dataset.theme = "light";
          document.querySelector('meta[name="theme-color"]').content = "#ffffff";
        }
      } catch {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    <canvas id="network" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={root}>Zhuoyuan Li</a>
      <div class="header-actions">
        <nav aria-label="Primary"><a href={root + "#about"}>About</a><a href={root + "#research"}>Research</a><a href={root + "#education"}>Education</a><a href={root + "cv/"}>CV</a></nav>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light theme" hidden>
          <Sun class="theme-sun" size={19} stroke-width={1.6} aria-hidden="true" />
          <Moon class="theme-moon" size={19} stroke-width={1.6} aria-hidden="true" />
          <span class="theme-tooltip" aria-hidden="true">Switch to light theme</span>
        </button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <dialog id="figure-dialog" class="figure-dialog" aria-label="Research figure" aria-describedby="figure-caption">
      <button class="figure-close" type="button" aria-label="Close figure" title="Close figure" autofocus><X size={21} stroke-width={1.7} aria-hidden="true" /></button>
      <img id="figure-preview" alt="" />
      <p id="figure-caption"></p>
    </dialog>
    <footer class="site-footer">
      <a href="mailto:li5917@purdue.edu">li5917@purdue.edu</a>
      <div><span>September 2026</span><label class="motion-control"><input type="checkbox" id="motion" /> Background motion</label></div>
    </footer>
    <script>
      const figureDialog = document.querySelector<HTMLDialogElement>("#figure-dialog")!;
      const figurePreview = document.querySelector<HTMLImageElement>("#figure-preview")!;
      const figureCaption = document.querySelector<HTMLElement>("#figure-caption")!;
      let figureTrigger: HTMLAnchorElement | null = null;
      document.querySelectorAll<HTMLAnchorElement>(".research-entry figure > a, .detail figure > a").forEach((link) => {
        link.addEventListener("click", (event) => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const img = link.querySelector("img");
          if (!img || !figureDialog.showModal) return;
          event.preventDefault();
          figureTrigger = link;
          figurePreview.src = link.href;
          figurePreview.alt = img.alt;
          figureCaption.textContent = link.closest("figure")?.querySelector<HTMLElement>("figcaption")?.innerText.replace(/\s+/g, " ").trim() ?? "";
          figureDialog.showModal();
          document.body.classList.add("figure-open");
        });
      });
      figureDialog.querySelector("button")!.addEventListener("click", () => figureDialog.close());
      figureDialog.addEventListener("click", (event) => { if (event.target === figureDialog) figureDialog.close(); });
      figureDialog.addEventListener("close", () => {
        document.body.classList.remove("figure-open");
        figureTrigger?.focus({preventScroll:true});
      });
      const themeButton = document.querySelector<HTMLButtonElement>("#theme-toggle")!;
      const themeTooltip = themeButton.querySelector<HTMLElement>(".theme-tooltip")!;
      function updateThemeControl() {
        const light = document.documentElement.dataset.theme === "light";
        const label = light ? "Switch to dark theme" : "Switch to light theme";
        themeButton.setAttribute("aria-label", label);
        themeTooltip.textContent = label;
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = light ? "#ffffff" : "#090a0c";
      }
      themeButton.hidden = false;
      updateThemeControl();
      themeButton.addEventListener("click", () => {
        const theme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem("portfolio-theme", theme); } catch {}
        updateThemeControl();
        document.dispatchEvent(new Event("themechange"));
      });
      addEventListener("storage", (event) => {
        if (event.key !== "portfolio-theme") return;
        document.documentElement.dataset.theme = event.newValue === "light" ? "light" : "dark";
        updateThemeControl();
        document.dispatchEvent(new Event("themechange"));
      });
      const canvas = document.querySelector<HTMLCanvasElement>("#network")!;
      const ctx = canvas.getContext("2d");
      const toggle = document.querySelector<HTMLInputElement>("#motion")!;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      let saved: string | null = null;
      try { saved = localStorage.getItem("portfolio-motion"); } catch {}
      toggle.checked = !reduced.matches && saved !== "off";
      if (ctx) {
        const context = ctx;
        let particleColor = getComputedStyle(document.documentElement).getPropertyValue("--particle-rgb").trim();
        let width = 0, height = 0, frame = 0, last = 0;
        let points: {x:number; y:number; vx:number; vy:number}[] = [];
        function draw(step: number) {
          context.clearRect(0, 0, width, height);
          for (const p of points) {
            p.x += p.vx * step; p.y += p.vy * step;
            if (p.x < 0 || p.x > width) p.vx *= -1;
            if (p.y < 0 || p.y > height) p.vy *= -1;
            context.fillStyle = "rgba(" + particleColor + ",.65)";
            context.beginPath(); context.arc(p.x, p.y, 1.2, 0, Math.PI * 2); context.fill();
          }
          for (let i = 0; i < points.length; i++) for (let j = i + 1; j < points.length; j++) {
            const a = points[i], b = points[j], distance = Math.hypot(a.x - b.x, a.y - b.y);
            if (distance < 165) {
              context.strokeStyle = "rgba(" + particleColor + "," + (.28 * (1 - distance / 165)) + ")";
              context.beginPath(); context.moveTo(a.x, a.y); context.lineTo(b.x, b.y); context.stroke();
            }
          }
        }
        function resize() {
          width = innerWidth; height = innerHeight;
          const dpr = Math.min(devicePixelRatio, 2);
          canvas.width = width * dpr; canvas.height = height * dpr;
          context.setTransform(dpr, 0, 0, dpr, 0, 0);
          points = Array.from({length: Math.max(18, Math.min(65, Math.floor(width * height / 20000)))}, () => ({x:Math.random()*width, y:Math.random()*height, vx:(Math.random()-.5)*.16, vy:(Math.random()-.5)*.16}));
          draw(0);
        }
        function tick(now: number) { draw(Math.min((now - last) / 16.67, 2)); last = now; frame = requestAnimationFrame(tick); }
        function sync() { cancelAnimationFrame(frame); if (toggle.checked && !document.hidden) { last = performance.now(); frame = requestAnimationFrame(tick); } }
        toggle.addEventListener("change", () => { saved = toggle.checked ? "on" : "off"; try { localStorage.setItem("portfolio-motion", saved); } catch {} sync(); });
        reduced.addEventListener("change", () => { toggle.checked = !reduced.matches && saved !== "off"; sync(); });
        document.addEventListener("visibilitychange", sync);
        document.addEventListener("themechange", () => { particleColor = getComputedStyle(document.documentElement).getPropertyValue("--particle-rgb").trim(); draw(0); });
        addEventListener("resize", resize);
        resize(); sync();
      } else { toggle.disabled = true; }
    </script>
  </body>
</html>
